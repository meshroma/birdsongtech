[Unit]
Description=Visualizzazione LCD Monitoraggio Bioacustico
After=birdsong.service multi-user.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/python3 /home/pi/display_last.py
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYVTDisallocate=no
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
